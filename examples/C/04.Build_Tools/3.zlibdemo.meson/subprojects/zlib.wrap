[wrap-file]
directory = zlib-1.3.2
# zlib.net no longer serves this release; the GitHub release asset is the
# identical tarball, so source_hash stays the same.
source_url = https://github.com/madler/zlib/releases/download/v1.3.2/zlib-1.3.2.tar.xz
source_fallback_url = https://wrapdb.mesonbuild.com/v2/zlib_1.3.2-1/get_source/zlib-1.3.2.tar.xz
source_filename = zlib-1.3.2.tar.xz
source_hash = d7a0654783a4da529d1bb793b7ad9c3318020af77667bcae35f95d0e42a792f3
# The same WrapDB patch, mirrored on GitHub so both downloads work when
# wrapdb.mesonbuild.com is unavailable.
patch_filename = zlib_1.3.2-1_patch.zip
patch_url = https://github.com/mesonbuild/wrapdb/releases/download/zlib_1.3.2-1/zlib_1.3.2-1_patch.zip
patch_fallback_url = https://wrapdb.mesonbuild.com/v2/zlib_1.3.2-1/get_patch
patch_hash = 5ae7a2e92f823df118cfb8c1b23d94e3117864392b3446581d669049b2fba6dd
wrapdb_version = 1.3.2-1

[provide]
dependency_names = zlib
